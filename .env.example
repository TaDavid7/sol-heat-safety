# --- Claude ---
ANTHROPIC_API_KEY=
# SOL_MODEL=claude-opus-5-5

# --- Twilio (leave blank to run with calls ringing in the terminal) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX          # your Twilio number
PUBLIC_URL=                        # e.g. https://xxxx.trycloudflare.com (no trailing slash)

# --- People ---
SUPERVISOR_PHONE=+1XXXXXXXXXX      # Phone B (verify it on a trial account)
SUPERVISOR_NAME=Supervisor
SUPERVISOR_LANGUAGE=en             # en | es (emergency call script)
DEMO_PHONE=+1XXXXXXXXXX            # Phone A: every worker call goes here
# DEMO_WORKER_ID=w3                # who an inbound call from DEMO_PHONE is (default: last worker called)

# --- Farm + simulation ---
FARM_NAME=Sunrise Farms
FARM_LAT=33.6803
FARM_LNG=-116.1739
SIMULATE=true
SIM_SPEED=30
# ROUTINE_CALLS=false              # off by default in simulation

# --- Thresholds (defaults shown) ---
# HEAT_TRIGGER_F=80
# HIGH_HEAT_F=95
# BREAK_OVERDUE_MIN=120
# NOT_MOVING_MIN=10
# WARNING_FOLLOW_UP_MIN=20
# RETRY_AFTER_SEC=30               # 120 outside simulation

# --- Guardrails ---
# MAX_CALLS_PER_HOUR=40
# MAX_SPEND_USD=20
# MAX_WORKER_TURNS=6
# RING_TIMEOUT_SEC=45
# CLAUDE_TIMEOUT_MS=12000
# ACK_TIMEOUT_SEC=120
# MAX_PAGES=3
# GPS_TOKEN=                       # bearer token required on POST /api/gps
