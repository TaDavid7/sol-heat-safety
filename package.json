{
  "name": "sol-heat-safety",
  "version": "1.0.0",
  "description": "Screenless heat-safety voice agent for farmworkers (Claude + Twilio)",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test test/webhooks.test.js",
    "test:eval": "node --env-file-if-exists=.env --test test/conversation.eval.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "express": "^5.3.0"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.9"
  }
}
